{
  "datasets": [
    {
      "name": "1fceeb76",
      "displayName": "by BusinessTravel",
      "queryLines": [
        "SELECT \n",
        "  BusinessTravel, \n",
        "  COUNT(*) as Total, \n",
        "  SUM(CASE WHEN Attrition = 'Yes' THEN 1 ELSE 0 END) as ChurnCount,\n",
        "  ROUND((SUM(CASE WHEN Attrition = 'Yes' THEN 1 ELSE 0 END) / COUNT(*)) * 100, 2) as SegmentChurnRate,\n",
        "  SUM(CASE WHEN Attrition = 'No' THEN 1 ELSE 0 END) as RetainCount,\n",
        "  ROUND((SUM(CASE WHEN Attrition = 'No' THEN 1 ELSE 0 END) / COUNT(*)) * 100, 2) as RetainRate\n",
        "FROM hr_employee_attrition\n",
        "GROUP BY BusinessTravel\n",
        "\n",
        "\n"
      ]
    },
    {
      "name": "b23ebd4a",
      "displayName": "by Department",
      "queryLines": [
        "SELECT \r\n",
        "  Department, \r\n",
        "  COUNT(*) as Total, \r\n",
        "  SUM(CASE WHEN Attrition = 'Yes' THEN 1 ELSE 0 END) as ChurnCount,\r\n",
        "  ROUND((SUM(CASE WHEN Attrition = 'Yes' THEN 1 ELSE 0 END) / COUNT(*)) * 100, 2) as SegmentChurnRate,\r\n",
        "  SUM(CASE WHEN Attrition = 'No' THEN 1 ELSE 0 END) as RetainCount,\r\n",
        "  ROUND((SUM(CASE WHEN Attrition = 'No' THEN 1 ELSE 0 END) / COUNT(*)) * 100, 2) as RetainRate\r\n",
        "FROM hr_employee_attrition\r\n",
        "GROUP BY Department"
      ]
    },
    {
      "name": "5c824982",
      "displayName": "by Distance from home",
      "queryLines": [
        "SELECT\r\n",
        "  CASE\r\n",
        "    WHEN DistanceFromHome >= 0 AND DistanceFromHome < 10 THEN '0-10'\r\n",
        "    WHEN DistanceFromHome >= 10 AND DistanceFromHome < 20 THEN '10-20'\r\n",
        "    WHEN DistanceFromHome >= 20 AND DistanceFromHome <= 30 THEN '20-30'\r\n",
        "  END AS distance_group,\r\n",
        "  COUNT(*) as num_employees\r\n",
        "FROM `hr_employee_attrition`\r\n",
        "WHERE attrition = 'Yes'\r\n",
        "  AND DistanceFromHome >= 0\r\n",
        "  AND DistanceFromHome <= 30\r\n",
        "GROUP BY distance_group\r\n",
        "ORDER BY num_employees DESC"
      ]
    },
    {
      "name": "f0f1acb9",
      "displayName": "Education by YearsinCurRole",
      "queryLines": [
        "SELECT \r\n",
        "  Education, \r\n",
        "  CASE\r\n",
        "    WHEN YearsInCurrentRole >= 0 AND YearsInCurrentRole < 5 THEN '0-5'\r\n",
        "    WHEN YearsInCurrentRole >= 5 AND YearsInCurrentRole < 10 THEN '5-10'\r\n",
        "    WHEN YearsInCurrentRole >= 10 AND YearsInCurrentRole < 15 THEN '10-15'\r\n",
        "    WHEN YearsInCurrentRole >= 15 AND YearsInCurrentRole < 20 THEN '15-20'\r\n",
        "    ELSE '20+'\r\n",
        "  END AS YearsInCurrentRole_Group,\r\n",
        "  COUNT(*) as Total,\r\n",
        "  SUM(CASE WHEN Attrition = 'Yes' THEN 1 ELSE 0 END) as ChurnCount,\r\n",
        "  ROUND((SUM(CASE WHEN Attrition = 'Yes' THEN 1 ELSE 0 END) / COUNT(*)) * 100, 2) as AttritionRate\r\n",
        "FROM hr_employee_attrition\r\n",
        "GROUP BY Education, YearsInCurrentRole_Group\r\n",
        "ORDER BY Education, YearsInCurrentRole_Group"
      ]
    },
    {
      "name": "93c4d7c5",
      "displayName": "income by salaryhike",
      "queryLines": [
        "SELECT\r\n",
        "  CASE\r\n",
        "    WHEN MonthlyIncome >= 0 AND MonthlyIncome < 5000 THEN '0-5000'\r\n",
        "    WHEN MonthlyIncome >= 5000 AND MonthlyIncome < 10000 THEN '5000-10000'\r\n",
        "    WHEN MonthlyIncome >= 10000 AND MonthlyIncome < 15000 THEN '10000-15000'\r\n",
        "    WHEN MonthlyIncome >= 15000 AND MonthlyIncome < 20000 THEN '15000-20000'\r\n",
        "    ELSE '20000+'\r\n",
        "  END AS income_group,\r\n",
        "  CASE\r\n",
        "    WHEN PercentSalaryHike >= 11 AND PercentSalaryHike <= 15 THEN '11-15'\r\n",
        "    WHEN PercentSalaryHike >= 16 AND PercentSalaryHike <= 20 THEN '16-20'\r\n",
        "    WHEN PercentSalaryHike >= 21 AND PercentSalaryHike <= 25 THEN '21-25'\r\n",
        "    ELSE 'Other'\r\n",
        "  END AS salary_hike_group,\r\n",
        "  COUNT(*) AS Total,\r\n",
        "  SUM(CASE WHEN Attrition = 'Yes' THEN 1 ELSE 0 END) AS ChurnCount,\r\n",
        "  ROUND((SUM(CASE WHEN Attrition = 'Yes' THEN 1 ELSE 0 END) / COUNT(*)) * 100, 2) AS AttritionRate,\r\n",
        "  SUM(CASE WHEN Attrition = 'No' THEN 1 ELSE 0 END) AS RetainCount,\r\n",
        "  ROUND((SUM(CASE WHEN Attrition = 'No' THEN 1 ELSE 0 END) / COUNT(*)) * 100, 2) AS RetainRate\r\n",
        "FROM hr_employee_attrition\r\n",
        "GROUP BY income_group, salary_hike_group\r\n",
        "ORDER BY income_group, salary_hike_group"
      ]
    },
    {
      "name": "c20f6d47",
      "displayName": "overall",
      "queryLines": [
        "SELECT\r\n",
        "  'ChurnRate' AS RateType,\r\n",
        "  ROUND((SUM(CASE WHEN Attrition = 'Yes' THEN 1 ELSE 0 END) / COUNT(*)) * 100, 2) AS RateValue\r\n",
        "FROM hr_employee_attrition\r\n",
        "\r\n",
        "UNION ALL\r\n",
        "\r\n",
        "SELECT\r\n",
        "  'RetainRate' AS RateType,\r\n",
        "  ROUND((SUM(CASE WHEN Attrition = 'No' THEN 1 ELSE 0 END) / COUNT(*)) * 100, 2) AS RateValue\r\n",
        "FROM hr_employee_attrition"
      ]
    }
  ],
